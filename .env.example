# CampusReserve configuration template. Copy to backend/.env and fill in.
# Never commit real values.

# ---- API (backend) ---------------------------------------------------------
NODE_ENV=development
PORT=4000
TZ=Asia/Kolkata

# Oracle schema owner created as described in documentation/DEPLOYMENT_GUIDE.md
DB_USER=campus
DB_PASSWORD=
# Local Oracle XE 21c:      localhost:1521/XEPDB1
# Local Oracle Free:        localhost:1521/FREEPDB1
# Autonomous DB (TLS):      (description=(address=(protocol=tcps)(port=1521)(host=...))(connect_data=(service_name=..._low.adb.oraclecloud.com))(security=(ssl_server_dn_match=yes)))
DB_CONNECT_STRING=localhost:1521/XEPDB1
# Only for mTLS wallet connections:
DB_WALLET_DIR=
DB_WALLET_PASSWORD=
DB_POOL_MIN=1
DB_POOL_MAX=8

# At least 32 random characters in production, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=10

# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173

# ---- Front end (frontend/.env) ----------------------------------------------
# Leave empty locally (Vite proxies /api to the PORT above). In Netlify set to the Render URL.
VITE_API_URL=
